# Outline
OUTLINE_API_URL=https://wiki.class.day/api
OUTLINE_API_KEY=ol_api_xxx
# 순회를 시작할 루트 컬렉션 ID (OUTLINE_DOCUMENT_ID 미설정 시 필수)
OUTLINE_ROOT_COLLECTION_ID=
# 설정 시 컬렉션 전체 대신 이 문서(+하위 트리)만 순회. 설정하면 위보다 우선
OUTLINE_DOCUMENT_ID=

# 퀴즈 생성 LLM: gemini(무료 티어, 기본값) | claude(유료 종량제)
QUIZ_PROVIDER=gemini

# QUIZ_PROVIDER=gemini 일 때 (https://aistudio.google.com 에서 발급, 무료 티어 가능)
GEMINI_API_KEY=AIzaxxx

# QUIZ_PROVIDER=claude 일 때 (Claude.ai Max 구독과는 별개의 유료 종량제 키)
ANTHROPIC_API_KEY=sk-ant-xxx

# 비워두면 provider별 기본값(gemini-3.5-flash-lite / claude-haiku-4-5) 사용
QUIZ_MODEL=

# 파이프라인 튜닝
# 랜덤 샘플링할 청크 개수
SAMPLE_CHUNK_COUNT=15
QUESTION_COUNT=3

# 전달 방식: outline | slack | discord | google_chat | email | cli
DELIVERY_MODE=cli

# DELIVERY_MODE=outline 일 때
OUTLINE_QUIZ_LOG_COLLECTION_ID=

# DELIVERY_MODE=slack 일 때
SLACK_WEBHOOK_URL=

# DELIVERY_MODE=discord 일 때 (서버 설정 → 연동 → 웹후크에서 발급)
DISCORD_WEBHOOK_URL=

# DELIVERY_MODE=google_chat 일 때 (스페이스 → 앱 및 통합 → 웹훅 추가에서 발급)
GOOGLE_CHAT_WEBHOOK_URL=

# DELIVERY_MODE=email 일 때
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_TO=

# ──────────────────────────────────────────────────────────────────
# 주의: python-dotenv는 `KEY=            # 설명` 처럼 값이 비어있고 뒤에 인라인
# 주석만 있는 줄을 파싱할 때, 그 주석 텍스트 자체를 값으로 읽어버리는 경우가 있다
# (실제 재현: OUTLINE_ROOT_COLLECTION_ID가 "# 순회를 시작할..." 문자열 그 자체로
# 채워져 config.py의 빈 값 체크를 통과해버림 → 2026-09-30 확인). 그래서 이 파일은
# 설명을 항상 키 위 별도 줄에 쓰고, `KEY=값` 뒤에는 주석을 붙이지 않는다. 이 파일에
# 새 항목을 추가할 때도 이 규칙을 지킬 것.

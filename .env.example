# Outline
OUTLINE_API_URL=https://wiki.class.day/api
OUTLINE_API_KEY=ol_api_xxx
OUTLINE_ROOT_COLLECTION_ID=            # 순회를 시작할 루트 컬렉션 ID (OUTLINE_DOCUMENT_ID 미설정 시 필수)
OUTLINE_DOCUMENT_ID=                   # 설정 시 컬렉션 전체 대신 이 문서(+하위 트리)만 순회. 설정하면 위보다 우선

# 퀴즈 생성 LLM: gemini(무료 티어, 기본값) | claude(유료 종량제)
QUIZ_PROVIDER=gemini

# QUIZ_PROVIDER=gemini 일 때 (https://aistudio.google.com 에서 발급, 무료 티어 가능)
GEMINI_API_KEY=AIzaxxx

# QUIZ_PROVIDER=claude 일 때 (Claude.ai Max 구독과는 별개의 유료 종량제 키)
ANTHROPIC_API_KEY=sk-ant-xxx

QUIZ_MODEL=                         # 비워두면 provider별 기본값(gemini-3.5-flash-lite / claude-haiku-4-5) 사용

# 파이프라인 튜닝
SAMPLE_CHUNK_COUNT=15               # 랜덤 샘플링할 청크 개수
QUESTION_COUNT=3

# 전달 방식: outline | slack | email | cli
DELIVERY_MODE=cli

# DELIVERY_MODE=outline 일 때
OUTLINE_QUIZ_LOG_COLLECTION_ID=

# DELIVERY_MODE=slack 일 때
SLACK_WEBHOOK_URL=

# DELIVERY_MODE=email 일 때
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_TO=
